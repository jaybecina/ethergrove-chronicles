# Every check before code leaves the machine (~3 min, decision 0008): this replaces GitHub CI.
# Lint, typecheck, tests with coverage, build, debug-hook and size checks, e2e on Chromium and WebKit.
# The checks run on the working tree, so it must match what is being pushed.
# Skip once with: git push --no-verify
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: uncommitted or untracked files would change the result; commit or stash them first."
  echo "  (git stash -u, push, then git stash pop)"
  git status --short
  exit 1
fi
node scripts/checks.mjs push
